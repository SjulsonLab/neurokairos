<?xml version="1.0" standalone='no'?>
<!DOCTYPE service-group SYSTEM "avahi-service.dtd">
<!-- Advertises the NeuroKairos dashboard so sender agents can push pulse onsets
     to it for cadence monitoring. Server images only. Installed to
     /etc/avahi/services/ where avahi-daemon publishes it. -->
<service-group>
  <name replace-wildcards="yes">NeuroKairos dashboard on %h</name>
  <service>
    <type>_neurokairos-dashboard._tcp</type>
    <port>80</port>
  </service>
</service-group>
