[Unit]
Description=NeuroKairos status agent
Documentation=https://github.com/SjulsonLab/neurokairos
After=network-online.target chrony.service
Wants=network-online.target

[Service]
Type=simple
User=root
# Lowest possible priority so serving the status page can never compete with the
# RT IRIG-H sender: SCHED_IDLE runs only on otherwise-idle CPU, and the sender's
# SCHED_FIFO-80 pulse thread (a separate process) preempts it unconditionally.
Nice=19
CPUSchedulingPolicy=idle
ExecStart=/usr/bin/python3 /usr/local/sbin/nk_status_agent.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
